# ============================================
# CV ONE SHOT - Environment Variables
# ============================================
# Copia questo file in .env.local e compila i valori

# --- SUPABASE ---
# Da: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- OPENAI ---
# Da: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# --- STRIPE ---
# Da: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ID dei prezzi Stripe (crea i prodotti su Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# --- APP ---
# L'URL del tuo sito (es. https://cvoneshot.com o https://cv-one-shot.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
